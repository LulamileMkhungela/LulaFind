<?xml version="1.0" encoding="utf-8"?>
<!-- LulaFind mark: a magnifier holding the location pin where the person was
     last seen. 108dp adaptive-icon canvas, artwork kept inside the 66dp safe
     zone. Geometry matches src/assets/logo-mark.svg so the vector used on
     API 26+ and the PNG used below it cannot drift apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <!-- the lens: soft fill, then the rim -->
        <path
            android:pathData="M318,200 A112,112 0 1 1 94,200 A112,112 0 1 1 318,200"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.16" />
        <path
            android:pathData="M318,200 A112,112 0 1 1 94,200 A112,112 0 1 1 318,200"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30"
            android:fillColor="#00000000" />
        <!-- handle -->
        <path
            android:pathData="M288,282 L398,392"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="34"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- the pin, inside the lens. translate(206,186) scale(8) translate(-12,-9)
             collapses to scale 8 with translate (110,114). -->
        <group
            android:translateX="110"
            android:translateY="114"
            android:scaleX="8"
            android:scaleY="8">
            <path
                android:pathData="M12,2a7,7 0 0,0 -7,7c0,5.25 7,13 7,13s7,-7.75 7,-13a7,7 0 0,0 -7,-7z"
                android:fillColor="#FFFFFF" />
        </group>
        <!-- the hole in the pin takes the tile colour underneath -->
        <path
            android:pathData="M227,186 A21,21 0 1 1 185,186 A21,21 0 1 1 227,186"
            android:fillColor="#2196F3" />
    </group>
</vector>
